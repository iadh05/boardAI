# Copy to apps/server/.env (git-ignored). Every variable the server reads is listed here.
PORT=3000
# openai-compatible (Ollama, Azure OpenAI…) or fake (scripted answers: tests, CI, offline work)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
# Build once: ollama create designroom-qwen -f infra/ollama/Modelfile (16k context, M1-15)
LLM_MODEL=designroom-qwen
# Longest silence from the model before giving up (the first call after a pause loads the model: ~20 s)
LLM_TIMEOUT_MS=60000
# debug | info | warn | error
LOG_LEVEL=info
