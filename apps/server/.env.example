# Copy to apps/server/.env (git-ignored). Every variable the server reads is listed here.
PORT=3000
# openai-compatible (Ollama, Azure OpenAI…) or fake (scripted answers: tests, CI, offline work)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
# Build once: ollama create designroom-qwen -f infra/ollama/Modelfile (16k context, M1-15)
LLM_MODEL=designroom-qwen
# Longest silence from the model before giving up (the first call after a pause loads the model: ~20 s)
LLM_TIMEOUT_MS=60000
# The model's context window: must match num_ctx in infra/ollama/Modelfile. Sizes the chat budget.
LLM_CONTEXT_TOKENS=131072
# With LLM_PROVIDER=fake: scripted conversations to play (see apps/web/e2e/fixtures/llm/scenarios.json)
# LLM_SCENARIO_FILE=../web/e2e/fixtures/llm/scenarios.json
# Diagnosing the agent: every model call, exactly as sent and answered, appended to this local file
# (JSON Lines). It holds boards and conversations: leave unset unless you need it; never commit it.
# Read it with: node scripts/show-llm-calls.ts <file>
# LLM_CALL_LOG=./llm-calls.jsonl
# debug | info | warn | error
LOG_LEVEL=info
# Error tracking: a DSN from the local GlitchTip (`node scripts/glitchtip-setup.ts` writes it) or
# from sentry.io (Settings → Client Keys). Unset = off.
# SENTRY_DSN=http://<key>@localhost:8000/<project>
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development
# Traces + metrics (OpenTelemetry, OTLP/HTTP): the Grafana LGTM container (docker compose). Unset = off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Phoenix (docker compose --profile agent up -d phoenix): the same traces, shown as agent runs. Needs
# OTEL_EXPORTER_OTLP_ENDPOINT. With TRACE_CONTENT=true the spans also hold prompts, boards, answers
# and tool arguments: only for a local Phoenix, never a hosted one.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# TRACE_CONTENT=true
# Debug routes that break things on purpose (GET /api/debug/boom = a real bug), to check error
# tracking, the overview dashboard and its alerts end to end. Development only.
# ENABLE_DEBUG_ROUTES=true
