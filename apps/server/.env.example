# Copy to apps/server/.env (git-ignored). Every variable the server reads is listed here.
PORT=3000
# openai-compatible (Ollama, Azure OpenAI…) or fake (scripted answers: tests, CI, offline work)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
# Build once: ollama create designroom-qwen -f infra/ollama/Modelfile (16k context, M1-15)
LLM_MODEL=designroom-qwen
# Longest silence from the model before giving up (the first call after a pause loads the model: ~20 s)
LLM_TIMEOUT_MS=60000
# With LLM_PROVIDER=fake: scripted conversations to play (see apps/web/e2e/fixtures/llm/scenarios.json)
# LLM_SCENARIO_FILE=../web/e2e/fixtures/llm/scenarios.json
# debug | info | warn | error
LOG_LEVEL=info
# Error tracking: the server project's DSN from sentry.io (Settings → Client Keys). Unset = off.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development
