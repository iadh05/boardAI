# Root .env (git-ignored): settings for docker-compose.yml. The apps have their own .env files
# (apps/server/.env.example, apps/web/.env.example).

# Nginx listens on this machine only. 0.0.0.0 opens the app to your network (phone testing on a
# trusted Wi-Fi): anyone there can then use it and its GPU.
# EDGE_BIND=127.0.0.1

# Grafana's admin password (http://localhost:3001); admin when unset. Used when Grafana's volume
# is new only.
# GRAFANA_ADMIN_PASSWORD=<openssl rand -hex 16>

# Local GlitchTip (M1-25b, `docker compose --profile errors up -d`). `node scripts/glitchtip-setup.ts`
# generates the admin credentials here on first run.
# GLITCHTIP_ADMIN_EMAIL=admin@designroom.localhost
# GLITCHTIP_ADMIN_PASSWORD=<generated>
# Signs this local instance's sessions; a fixed dev value is used when unset.
# GLITCHTIP_SECRET_KEY=<openssl rand -hex 32>
