{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@designroom/web", "dev"],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@designroom/server", "dev"],
      "port": 3000
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@designroom/web",
        "exec",
        "vite",
        "preview",
        "--port",
        "4180",
        "--strictPort"
      ],
      "env": {
        "API_URL": "http://localhost:3000"
      },
      "port": 4180
    }
  ]
}
